# ── Night.inc Environment Variables ──────────────────────────────────────────
# Copy to .env.local (Vite) and .env (server.js)

# ── Founder Portal ───────────────────────────────────────────────────────────
VITE_FOUNDER_PASSWORD=night300

# ── Square ───────────────────────────────────────────────────────────────────
# Payment links (create at: squareup.com/dashboard/online-checkout)
VITE_SQUARE_2AM_URL=https://square.link/u/XXXXXXXX
VITE_SQUARE_CLIKEY_URL=https://square.link/u/YYYYYYYY

# Server-side Square credentials (squareup.com/developers)
SQUARE_ACCESS_TOKEN=EAAAl...
SQUARE_LOCATION_ID=L...
SQUARE_WEBHOOK_SECRET=...
SQUARE_WEBHOOK_URL=https://yourdomain.com/webhooks/square

# ── Printify ─────────────────────────────────────────────────────────────────
# Get from: printify.com/app/settings/integrations
PRINTIFY_API_TOKEN=...
PRINTIFY_SHOP_ID=...

# Product to reorder when $300 rule triggers
# Find blueprint/provider/variant IDs at: printify.com/app/catalog
PRINTIFY_BLUEPRINT_ID=12
PRINTIFY_PROVIDER_ID=99
PRINTIFY_VARIANT_ID=43565

# ── Server ───────────────────────────────────────────────────────────────────
PORT=3001
