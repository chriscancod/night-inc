# ── Night.inc Environment Variables ──────────────────────────────────────────
# Copy to .env (server) and .env.local (Vite frontend)

# ── Founder Portal ────────────────────────────────────────────────────────────
VITE_FOUNDER_PASSWORD=night300

# ── Square ────────────────────────────────────────────────────────────────────
VITE_SQUARE_2AM_URL=https://square.link/u/XXXXXXXX
VITE_SQUARE_CLIKEY_URL=https://square.link/u/YYYYYYYY
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_WEBHOOK_SECRET=
SQUARE_WEBHOOK_URL=https://nighthq.website/webhooks/square

# ── Printify ──────────────────────────────────────────────────────────────────
PRINTIFY_API_TOKEN=
PRINTIFY_SHOP_ID=
PRINTIFY_BLUEPRINT_ID=12
PRINTIFY_PROVIDER_ID=99
PRINTIFY_VARIANT_ID=43565

# ── GitHub (auto-rebuild when Printify product is published) ──────────────────
# Fine-grained PAT: github.com/settings/tokens → Contents(read) + Actions(write)
GITHUB_PAT=
GITHUB_OWNER=chriscancod
GITHUB_REPO_2AM=2am-cases

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
